{
  "expo": {
    "name": "GiftMemory",
    "slug": "gift-memory",
    "version": "1.0.0",
    "scheme": "giftmemory",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maxime.giftmemory",
      "infoPlist": {
        "NSCameraUsageDescription": "Pour prendre une photo du cadeau.",
        "NSPhotoLibraryUsageDescription": "Pour choisir une photo depuis la galerie.",
        "NSPhotoLibraryAddUsageDescription": "Pour sauvegarder les photos des cadeaux.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E8734A",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app accède à vos photos pour les cadeaux.",
          "cameraPermission": "L'app utilise la caméra pour photographier les cadeaux."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "privacyManifests": {
              "NSPrivacyAccessedAPITypes": [
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "CA92.1"
                  ]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "C617.1"
                  ]
                },
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "E174.1"
                  ]
                }
              ]
            }
          }
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "e12cf3b3-e99d-43de-b7e8-13731d3e45d0"
      }
    }
  }
}
